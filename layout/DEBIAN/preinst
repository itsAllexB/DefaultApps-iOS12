#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# When DefaultApps replaces DefaultBrowser, leave a note so the SpringBoard tweak carries the
# browser choice over on its first run (DefaultBrowser's defaults were: enabled, Firefox).
if [ "$1" = install ] || [ "$1" = upgrade ]; then
    if [ -e /Library/MobileSubstrate/DynamicLibraries/DefaultBrowser.dylib ] \
       || [ -e /var/lib/dpkg/info/com.itsallexb.defaultbrowser.list ] \
       || [ -e /var/mobile/Library/Preferences/com.itsallexb.defaultbrowser.plist ]; then
        mkdir -p /var/mobile/Library/DefaultApps
        touch /var/mobile/Library/DefaultApps/from-defaultbrowser
        chown -R 501:501 /var/mobile/Library/DefaultApps 2>/dev/null
    fi
fi
exit 0
